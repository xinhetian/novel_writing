# Deny by default: only reviewed application source belongs in Git.
*
!.gitignore
!.gitattributes
!package.json
!README.md
!server.mjs
!start.ps1
!start.cmd
!public/
!public/index.html
!public/style.css
!public/app.js
!scripts/
!scripts/check-repository.mjs
!tests/
!tests/server.test.mjs
!.githooks/
!.githooks/pre-commit
!.githooks/pre-push
